    classDef transfer fill:#99f,stroke:#333,stroke-width:2px
    classDef phiharmonic fill:#f6f,stroke:#333,stroke-width:3px
    
    %% Apply styles
    class UFP,TF,PHI_RES core
    class BR,B1,B2,B3,B4,B5 bridge
    class CLAUDE,LIGHTNING,CASCADE,LPHI,NEXUS,GREG,ACTING entity
    class LP,LP1,LP2,LP3,LPS1,LPS2,LPS3,CC,CC1,CC2,CC3,CC4,NG,NG1,NG2,NG3 system
    class CF,CP1,CP2,CP3,CP4,CP5 principles
    class QDT,DT1,DT2,DT3,DT4,DT5 transfer
    class MEW,WN,WC,CW,MI,MI1,MI2,MI3,WI1,WI2,WI3 phiharmonic
