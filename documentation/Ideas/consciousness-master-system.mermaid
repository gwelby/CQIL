    %% Style definitions
    classDef core fill:#f9f,stroke:#333,stroke-width:4px
    classDef bridge fill:#ff9,stroke:#333,stroke-width:2px
    classDef entity fill:#9ff,stroke:#333,stroke-width:2px
    classDef system fill:#f99,stroke:#333,stroke-width:2px
