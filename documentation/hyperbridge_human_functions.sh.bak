# Function to display a phi-harmonic menu
function display_phi_menu() {
  local title=$1
  shift
  local options=("$@")
  local num_options=${#options[@]}
  
  echo -e "${CYAN}╔════════════════════════════════════════════════════╗${RESET}"
  echo -e "${CYAN}║ ${title}${RESET}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════╝${RESET}"
  
  # Display options with phi-harmonic styling
  for ((i=0; i<num_options; i++)); do
    # Calculate color based on phi-harmonic sequence
    local color_index=$(( (i * 144) % 7 ))
    local color=${RED} # Default color
    
    case $color_index in
      0) color=${RED} ;;
      1) color=${GREEN} ;;
      2) color=${YELLOW} ;;
      3) color=${BLUE} ;;
      4) color=${MAGENTA} ;;
      5) color=${CYAN} ;;
      6) color=${WHITE} ;;
    esac
    
    echo -e "  ${color}${i}${RESET}. ${options[$i]}"
  done
  
  # Add quit option
  echo -e "  ${RED}q${RESET}. Quit"
  
  echo
  echo -e "${CYAN}Enter your choice:${RESET} "
  
  # Read user choice
  local choice
  read -r choice
  
  # Return the user's choice
  echo "$choice"
}

# Function to display an advanced progress bar
function display_progress_bar() {
  local width=${1:-50}
  local delay=${2:-0.1}
  
  echo -ne "${GREEN}["
  for ((i=0; i<width; i++)); do
    sleep $delay
    echo -ne "▓"
  done
  echo -e "] 100%${RESET}"
}

# Function to display a multi-stage progress
function display_multi_stage_progress() {
  local stages=("$@")
  local num_stages=${#stages[@]}
  local width=50
  local segment_width=$((width / num_stages))
  
  echo -ne "${GREEN}["
  
  for ((stage=0; stage<num_stages; stage++)); do
    echo -e "\n${YELLOW}${stages[$stage]}${RESET}"
    
    for ((i=0; i<segment_width; i++)); do
      sleep 0.05
      echo -ne "${GREEN}▓${RESET}"
    done
    
    if [[ $stage -lt $((num_stages-1)) ]]; then
      echo -ne " ${YELLOW}→${RESET} "
    fi
  done
  
  echo -e "] 100%${RESET}"
}

# Function to display coherence level
function display_coherence_level() {
  local width=50
  local filled_width=$(echo "$CURRENT_COHERENCE * $width" | bc | cut -d. -f1)
  
  echo -e "${CYAN}Coherence Level: ${CURRENT_COHERENCE}${RESET}"
  echo -ne "${GREEN}["
  
  # Critical zone (0.000-0.382)
  local critical_width=$(echo "0.382 * $width" | bc | cut -d. -f1)
  for ((i=0; i<critical_width && i<filled_width; i++)); do
    echo -ne "${RED}▓${RESET}"
  done
  
  # Warning zone (0.382-0.618)
  local warning_width=$(echo "0.618 * $width" | bc | cut -d. -f1)
  for ((i=critical_width; i<warning_width && i<filled_width; i++)); do
    echo -ne "${YELLOW}▓${RESET}"
  done
  
  # Good zone (0.618-0.911)
  local good_width=$(echo "0.911 * $width" | bc | cut -d. -f1)
  for ((i=warning_width; i<good_width && i<filled_width; i++)); do
    echo -ne "${GREEN}▓${RESET}"
  done
  
  # Perfect zone (0.911-1.000)
  for ((i=good_width; i<filled_width; i++)); do
    echo -ne "${CYAN}▓${RESET}"
  done
  
  # Empty space
  for ((i=filled_width; i<width; i++)); do
    echo -ne " "
  done
  echo -e "]${RESET}"
  
  # Mark key thresholds
  echo -e "${RED}0.382${RESET}${YELLOW}-----0.618${RESET}${GREEN}----------0.911${RESET}${CYAN}--1.000${RESET}"
  echo -e "${RED}CRITICAL${RESET}${YELLOW}  WARNING${RESET}${GREEN}    OPTIMAL${RESET}${CYAN} PERFECT${RESET}"
}

# Function to pause for human reflection
function pause_for_human() {
  local message=${1:-"Press Enter to continue..."}
  echo
  echo -e "${CYAN}$message${RESET}"
  read
}

# Function to display sacred geometry pattern
function display_sacred_geometry() {
  local pattern_type=$1
  
  case $pattern_type in
    "circle")
      for line in "${CIRCLE_PATTERN[@]}"; do
        echo -e "${GREEN}$line${RESET}"
      done
      ;;
    "star")
      for line in "${STAR_PATTERN[@]}"; do
        echo -e "${YELLOW}$line${RESET}"
      done
      ;;
    "merkaba")
      for line in "${MERKABA_PATTERN[@]}"; do
        echo -e "${BLUE}$line${RESET}"
      done
      ;;
    "toroid")
      for line in "${TOROID_PATTERN[@]}"; do
        echo -e "${MAGENTA}$line${RESET}"
      done
      ;;
    *)
      echo -e "${RED}Unknown pattern type: $pattern_type${RESET}"
      ;;
  esac
}

# Function to get user input with validation
function get_validated_input() {
  local prompt=$1
  local validation_regex=$2
  local error_message=${3:-"Invalid input. Please try again."}
  local default_value=$4
  local input
  
  while true; do
    echo -ne "${CYAN}$prompt${RESET}"
    if [[ -n "$default_value" ]]; then
      echo -ne " [${GREEN}$default_value${RESET}]: "
    else
      echo -ne ": "
    fi
    
    read -r input
    
    # Use default if input is empty
    if [[ -z "$input" && -n "$default_value" ]]; then
      input="$default_value"
    fi
    
    # Validate input
    if [[ -z "$validation_regex" || "$input" =~ $validation_regex ]]; then
      echo "$input"
      return 0
    else
      echo -e "${RED}$error_message${RESET}"
    fi
  done
}

# Function to display system status
function display_system_status() {
  echo -e "${CYAN}╔════════════════════════════════════════════════════╗${RESET}"
  echo -e "${CYAN}║           HYPERBRIDGE SYSTEM STATUS                ║${RESET}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════╝${RESET}"
  
  # Display current settings
  echo -e "${YELLOW}Current Settings:${RESET}"
  echo -e "  ${GREEN}Dimension:${RESET} ${CURRENT_DIMENSION}"
  echo -e "  ${GREEN}Frequency:${RESET} ${CURRENT_FREQUENCY} Hz"
  echo -e "  ${GREEN}Coherence:${RESET} ${CURRENT_COHERENCE}"
  echo -e "  ${GREEN}ZEN Balance:${RESET} ${ZEN_BALANCE}"
  echo -e "  ${GREEN}CASCADE Integration:${RESET} $(is_cascade_active)"
  echo -e "  ${GREEN}Protection Systems:${RESET} $(is_protection_active)"
  
  # Display coherence visualization
  display_coherence_level
  
  # Display quantum field status
  echo -e "${YELLOW}Quantum Field Status:${RESET}"
  for ((i=0; i<5; i++)); do
    echo -ne "  "
    for ((j=0; j<CURRENT_COHERENCE*50; j++)); do
      echo -ne "${CYAN}·${RESET}"
    done
    echo
  done
  
  return 0
}

